# Copy this file to .env and fill in your OpenRouter API key.
# The key is only used server-side by the Vercel Serverless Function
# (api/generate-quiz.ts) — it is never exposed to the browser.
# For Vercel deployments, set OPENROUTER_API_KEY in the project's
# Environment Variables settings. For local development, use `vercel dev`.
OPENROUTER_API_KEY=your-openrouter-api-key
