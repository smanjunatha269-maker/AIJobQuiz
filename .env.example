# Copy this file to .env and fill in your OpenRouter credentials.
# These variables are only used server-side by the Vercel Serverless Functions
# (api/generate-quiz.ts, api/generate-new-quiz.ts) — they are never exposed
# to the browser. For Vercel deployments, set them in the project's
# Environment Variables settings. For local development, use `vercel dev`.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
